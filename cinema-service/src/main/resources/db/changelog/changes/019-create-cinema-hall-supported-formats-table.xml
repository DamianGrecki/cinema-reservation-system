<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="019-create-cinema-hall-supported-formats" author="Damian G">

        <createTable tableName="cinema_hall_supported_formats">
            <column name="cinema_hall_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="movie_format" type="VARCHAR(50)">
                    <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="cinema_hall_supported_formats"
                baseColumnNames="cinema_hall_id"
                referencedTableName="cinema_halls"
                referencedColumnNames="id"
                constraintName="fk_ch_supported_formats_hall"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="cinema_hall_supported_formats"
                columnNames="cinema_hall_id, movie_format"
                constraintName="uk_ch_supported_formats"/>

        <createIndex
                tableName="cinema_hall_supported_formats"
                indexName="idx_ch_supported_formats_hall">
            <column name="cinema_hall_id"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
