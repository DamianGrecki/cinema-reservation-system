<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="004-create-hall-rows-table" author="Damian G">
        <createTable tableName="hall_rows">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="cinema_hall_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_hall_rows_cinema_hall"
                             references="cinema_halls(id)"/>
            </column>

            <column name="row_number" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="seats_count" type="INT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="hall_rows"
                columnNames="cinema_hall_id,row_number"
                constraintName="uq_hall_row_per_hall"/>
    </changeSet>

</databaseChangeLog>