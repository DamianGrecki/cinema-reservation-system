<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="003-create-cinema-halls-table" author="Damian G">
        <createTable tableName="cinema_halls">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="cinema_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_cinema_halls_cinema"
                             references="cinemas(id)"/>
            </column>

            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="cinema_halls"
                columnNames="cinema_id,name"
                constraintName="uq_cinema_hall_name_per_cinema"/>

    </changeSet>

</databaseChangeLog>