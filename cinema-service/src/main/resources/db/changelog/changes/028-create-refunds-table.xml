<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="028-create-refunds-table" author="Damian G">

        <createTable tableName="refunds">

            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="payment_attempt_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_refunds_payment_attempt"
                             references="payment_attempts(id)"/>
            </column>

            <column name="transaction_id" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>

            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="reason" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>

            <column name="created_at" type="TIMESTAMP WITH TIME ZONE" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <sql>
            CREATE UNIQUE INDEX uq_refunds_payment_attempt_completed
            ON refunds (payment_attempt_id)
            WHERE status = 'COMPLETED';
        </sql>

    </changeSet>

</databaseChangeLog>
