<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="006-create-seats-table" author="Damian G">
        <createTable tableName="seats">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="hall_row_id" type="UUID">
                <constraints nullable="false" foreignKeyName="fk_seats_hall_row"
                             references="hall_rows(id)"/>
            </column>

            <column name="seat_number" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="seat_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="seats"
                columnNames="hall_row_id,seat_number"
                constraintName="uq_seat_per_row"/>
    </changeSet>

</databaseChangeLog>