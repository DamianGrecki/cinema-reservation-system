<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="009-create-service-roles-table" author="Damian G">
        <createTable tableName="service_roles">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="service_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>

            <column name="role_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint
                tableName="service_roles"
                columnNames="service_id, role_type"
                constraintName="uq_service_roles_service_role"/>

        <addForeignKeyConstraint
                baseTableName="service_roles"
                baseColumnNames="service_id"
                referencedTableName="service_credentials"
                referencedColumnNames="id"
                constraintName="fk_serviceroles_service"
                onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
